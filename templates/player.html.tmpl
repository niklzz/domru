<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Камера {{ .Camera }}</title>
    <style>
        html, body { margin: 0; height: 100%; background: #0d1117; }
        body { display: flex; flex-direction: column; font: 600 15px -apple-system, system-ui, sans-serif; color: #fff; }
        video { flex: 1; min-height: 0; width: 100%; background: #000; object-fit: contain; }
        .row { display: flex; justify-content: space-between; align-items: center; gap: 6px; padding: 8px 12px 4px; }
        .row[hidden] { display: none; }
        #cut { justify-content: flex-start; flex-wrap: wrap; }
        #dl { text-decoration: none; }
        #dl:not([href]) { color: #9aa0a6; }
        .pill { font: inherit; color: inherit; background: #161b22; border: 0; border-radius: 999px; padding: 7px 14px; }
        #clock { background: #e5483d; font-variant-numeric: tabular-nums; }
        #live .dot { display: inline-block; width: 8px; height: 8px; margin-right: 6px; border: 3px solid #e5483d; border-radius: 50%; vertical-align: -2px; }
        #live.on .dot { background: #e5483d; }
        #ruler { display: block; width: 100%; height: 64px; touch-action: pan-y; cursor: grab; }
    </style>
</head>
<body>
<video id="v" playsinline controls disableremoteplayback></video>
<div class="row">
    <select id="day" class="pill" aria-label="День"></select>
    <span id="clock" class="pill"></span>
    <span>
        <button id="cut-toggle" class="pill" aria-label="Скачать интервал" title="Скачать интервал">⬇</button>
        <button id="live" class="pill"><span class="dot"></span>Live</button>
    </span>
</div>
<div class="row" id="cut" hidden>
    <button id="mark-from" class="pill">Начало <span id="from-t"></span></button>
    <button id="mark-to" class="pill">Конец <span id="to-t"></span></button>
    <a id="dl" class="pill"></a>
</div>
<canvas id="ruler" aria-label="Шкала времени: потяните, чтобы перейти"></canvas>
<script>
    var v = document.getElementById('v');
    var light = {{ .Light }};
    var aac = {{ .AAC }};
    var ts = {{ .TS }}; // archive start in unix seconds, 0 = live
    var depth = {{ .Depth }};
    // The server streams fragmented MP4 (fragments every 0.5 s). Browsers do
    // not play an endless MP4 from a plain src reliably (Safari never does), so
    // it is fed through Media Source Extensions: ManagedMediaSource is the
    // iPhone flavour (iOS 17.1+). Latency ends up ~2-3 s everywhere.
    var MS = window.ManagedMediaSource || window.MediaSource;
    var mime = 'video/mp4; codecs="avc1.4d002a, ' + (aac ? 'mp4a.40.2' : 'mp4a.6b') + '"';
    var stop = new AbortController();
    var base = null;     // media time of the first frame, which shows ts
    var loading = true;  // a new stream has not started playing yet
    var pausedAt = 0;

    function now() { return Date.now() / 1000; }
    function oldest() { return now() - depth + 60; } // older TS make the streamer hang
    // clock is the moment on screen. ponytail: live is taken as ~3 s behind.
    function clock() {
        if (stop.signal.aborted) return pausedAt;
        if (!ts) return now() - 3;
        return base === null ? ts : ts + v.currentTime - base;
    }

    // start plays from unix time t; anything in the last 10 s is live. The
    // archive arrives in real time, so every jump is a new request (~2-3 s).
    function start(t) {
        stop.abort();
        stop = new AbortController();
        ts = !t || t > now() - 10 ? 0 : Math.floor(Math.max(t, oldest()));
        base = null;
        loading = true;
        var q = [];
        if (light) q.push('light=1');
        if (ts) q.push('ts=' + ts);
        q = q.length ? '?' + q.join('&') : '';
        history.replaceState(null, '', location.pathname + q);
        var src = '/player/{{ .Camera }}/mp4' + q;
        if (MS && MS.isTypeSupported(mime)) feed(src, stop.signal, !!ts);
        else v.src = src; // ponytail: no MSE at all, let the browser try progressive playback
        // Try to start with sound; browsers allow that only after a user gesture
        // on the site, so fall back to a muted autoplay (tap the speaker to unmute).
        v.play().catch(function () {
            v.muted = true;
            v.play().catch(function () {});
        });
        draw();
    }

    function feed(src, signal, archive) {
        var ms = new MS();
        v.src = URL.createObjectURL(ms);
        ms.addEventListener('sourceopen', function () {
            URL.revokeObjectURL(v.src);
            var sb = ms.addSourceBuffer(mime);
            var queue = [];
            var keep = archive ? 120 : 10; // seconds kept behind the playhead for seeking back
            function pump() {
                if (sb.updating || ms.readyState !== 'open') return;
                if (queue.length) {
                    sb.appendBuffer(queue.shift());
                } else if (v.buffered.length && v.currentTime - v.buffered.start(0) > keep + 20) {
                    sb.remove(0, v.currentTime - keep); // keep the buffer small
                }
            }
            sb.addEventListener('updateend', pump);
            fetch(src, {signal: signal}).then(function (res) {
                if (!res.ok) throw new Error(res.status);
                var reader = res.body.getReader();
                function read() {
                    reader.read().then(function (chunk) {
                        if (chunk.done) { if (ms.readyState === 'open') ms.endOfStream(); return; }
                        queue.push(chunk.value);
                        pump();
                        read();
                    }).catch(function () {});
                }
                read();
            }).catch(function (e) { if (!signal.aborted) document.title = 'Поток недоступен (' + e.message + ')'; });
        }, {once: true});
    }

    // Stay near the live edge if the player fell behind (tab in background).
    setInterval(function () {
        if (ts || v.paused || !v.buffered.length) return;
        var end = v.buffered.end(v.buffered.length - 1);
        if (end - v.currentTime > 3) v.currentTime = end - 1;
    }, 1000);
    // A paused stream would keep downloading in real time with nowhere to put
    // it: drop it and resume from the same moment (live pauses into the archive).
    v.addEventListener('playing', function () { loading = false; });
    v.addEventListener('pause', function () {
        if (loading) return;
        pausedAt = clock();
        stop.abort();
    });
    v.addEventListener('play', function () { if (stop.signal.aborted) start(pausedAt); });

    // Ruler: the time under the red line in the middle is what plays. Drag it
    // or tap a spot to jump; the day picker keeps the time of day.
    var cv = document.getElementById('ruler'), cx = cv.getContext('2d');
    var clockEl = document.getElementById('clock'), day = document.getElementById('day');
    var pxPerSec = 0;        // set by draw: ~3 h across any screen, a tick every 5 min
    var drag = null;         // {x, from, t} while the ruler is dragged
    var pad = function (n) { return (n < 10 ? '0' : '') + n; };
    var dayLabel = function (d) {
        var s = d.toLocaleDateString('ru-RU', {weekday: 'short', day: 'numeric'});
        return s.charAt(0).toUpperCase() + s.slice(1);
    };
    var midnight = function (t) { var d = new Date(t * 1000); d.setHours(0, 0, 0, 0); return d.getTime() / 1000; };
    function shown() { return drag ? drag.t : clock(); }
    var hms = function (t) { var d = new Date(t * 1000); return pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds()); };

    // Download: marks at the moment under the red line. The archive arrives in
    // real time, so the file takes about as long as the interval.
    var cutRow = document.getElementById('cut'), dl = document.getElementById('dl');
    var cut = {from: 0, to: 0};
    function showCut() {
        cut.to = Math.min(cut.to, Math.floor(now()) - 10);
        document.getElementById('from-t').textContent = cut.from ? hms(cut.from) : '';
        document.getElementById('to-t').textContent = cut.to ? hms(cut.to) : '';
        var d = cut.to - cut.from;
        if (d > 0 && d <= 1800) {
            dl.href = '/player/{{ .Camera }}/download?from=' + cut.from + '&to=' + cut.to;
            var begin = new Date(cut.from * 1000);
            dl.download = 'domru-' + begin.getFullYear() + pad(begin.getMonth() + 1) + pad(begin.getDate()) + '-' + hms(cut.from).replace(/:/g, '') + '.mp4';
            dl.textContent = 'Скачать ' + Math.floor(d / 60) + ':' + pad(d % 60) + ' (~' + Math.ceil(d / 60) + ' мин)';
        } else {
            dl.removeAttribute('href');
            dl.textContent = d > 1800 ? 'Не больше 30 мин' : 'Конец раньше начала';
        }
        draw();
    }
    document.getElementById('cut-toggle').addEventListener('click', function () {
        cutRow.hidden = !cutRow.hidden;
        if (!cutRow.hidden && !cut.from) {
            cut.from = Math.floor(shown());
            cut.to = cut.from + 60;
        }
        showCut();
    });
    document.getElementById('mark-from').addEventListener('click', function () {
        var d = cut.to - cut.from;
        cut.from = Math.floor(shown());
        if (cut.to <= cut.from) cut.to = cut.from + (d > 0 ? d : 60);
        showCut();
    });
    document.getElementById('mark-to').addEventListener('click', function () {
        cut.to = Math.floor(shown());
        showCut();
    });
    function draw() {
        if (base === null && ts && v.buffered.length) base = v.buffered.start(0);
        var dpr = window.devicePixelRatio || 1, w = cv.clientWidth, h = cv.clientHeight;
        pxPerSec = w / (3 * 3600);
        if (cv.width !== Math.round(w * dpr)) { cv.width = Math.round(w * dpr); cv.height = Math.round(h * dpr); }
        cx.setTransform(dpr, 0, 0, dpr, 0, 0);
        cx.clearRect(0, 0, w, h);
        var at = shown(), n = now(), lo = oldest(), half = w / 2 / pxPerSec;
        if (!cutRow.hidden && cut.to > cut.from) { // the interval to download
            cx.fillStyle = 'rgba(229, 72, 61, .35)';
            cx.fillRect(w / 2 + (cut.from - at) * pxPerSec, 0, (cut.to - cut.from) * pxPerSec, h - 18);
        }
        cx.font = '500 13px -apple-system, system-ui, sans-serif';
        cx.textAlign = 'left';
        for (var t = Math.floor((at - half) / 300) * 300; t <= at + half; t += 300) {
            var x = w / 2 + (t - at) * pxPerSec, d = new Date(t * 1000), hour = d.getMinutes() === 0;
            var off = t > n || t < lo;
            cx.fillStyle = off ? '#2b3038' : '#fff';
            cx.fillRect(x - 1, 4, 2, hour ? 34 : 24);
            if (hour) {
                cx.fillStyle = off ? '#2b3038' : '#9aa0a6';
                cx.fillText(d.getHours() === 0 ? dayLabel(d) : pad(d.getHours()) + ':00', x + 6, h - 8);
            }
        }
        cx.fillStyle = '#e5483d';
        cx.fillRect(w / 2 - 1.5, 0, 3, h - 18);
        clockEl.textContent = hms(at);
        if (document.activeElement !== day) {
            if (Number(day.options[0].value) !== midnight(n)) fillDays(); // a new day began
            day.value = String(midnight(at));
        }
        document.getElementById('live').classList.toggle('on', !ts && !drag);
    }
    function fillDays() {
        day.textContent = '';
        for (var m = midnight(now()); m >= midnight(oldest()); m = midnight(m - 43200)) {
            day.add(new Option(dayLabel(new Date(m * 1000)), String(m)));
        }
    }
    cv.addEventListener('pointerdown', function (e) {
        drag = {x: e.clientX, from: clock(), t: clock()};
        cv.setPointerCapture(e.pointerId);
    });
    cv.addEventListener('pointermove', function (e) {
        if (!drag) return;
        drag.t = Math.min(now(), Math.max(oldest(), drag.from - (e.clientX - drag.x) / pxPerSec));
        draw();
    });
    cv.addEventListener('pointerup', function (e) {
        if (!drag) return;
        var t = Math.abs(e.clientX - drag.x) > 3 ? drag.t
            : drag.from + (e.clientX - cv.getBoundingClientRect().left - cv.clientWidth / 2) / pxPerSec;
        drag = null;
        start(t);
    });
    cv.addEventListener('pointercancel', function () { drag = null; draw(); });
    day.addEventListener('change', function () {
        var at = shown();
        start(Number(day.value) + (at - midnight(at)));
        day.blur();
    });
    document.getElementById('live').addEventListener('click', function () { start(0); });
    window.addEventListener('resize', draw);
    setInterval(draw, 250);
    fillDays();
    start(ts);
</script>
</body>
</html>
