<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ if .TS }}Архив{{ else }}Камера{{ end }} {{ .Camera }}</title>
    <style>
        html, body { margin: 0; height: 100%; background: #000; }
        body { display: flex; flex-direction: column; }
        video { flex: 1; min-height: 0; width: 100%; object-fit: contain; }
        #bar { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; padding: 6px; color: #eee; font: 14px sans-serif; }
        #bar button, #bar input, #bar a { font: inherit; padding: 4px 8px; }
        #bar a { color: #eee; }
        #clock { min-width: 9em; font-variant-numeric: tabular-nums; }
    </style>
</head>
<body>
<video id="v" playsinline controls disableremoteplayback></video>
{{ if .TS }}
<div id="bar">
    <span id="clock"></span>
    <button data-d="-600">−10 мин</button>
    <button data-d="-60">−1 мин</button>
    <button data-d="-10">−10 с</button>
    <button data-d="10">+10 с</button>
    <button data-d="60">+1 мин</button>
    <button data-d="600">+10 мин</button>
    <input id="at" type="datetime-local" step="1" aria-label="Перейти ко времени">
    <a href="?{{ if .Light }}light=1{{ end }}">онлайн</a>
</div>
{{ end }}
<script>
    var v = document.getElementById('v');
    var light = {{ .Light }};
    var aac = {{ .AAC }};
    var ts = {{ .TS }}; // archive start in unix seconds, 0 = live
    var depth = {{ .Depth }};
    var params = [];
    if (light) params.push('light=1');
    if (ts) params.push('ts=' + ts);
    var src = '/player/{{ .Camera }}/mp4' + (params.length ? '?' + params.join('&') : '');
    var stop = new AbortController();
    // The server streams fragmented MP4 (fragments every 0.5 s). Browsers do
    // not play an endless MP4 from a plain src reliably (Safari never does), so
    // it is fed through Media Source Extensions: ManagedMediaSource is the
    // iPhone flavour (iOS 17.1+). Latency ends up ~2-3 s everywhere.
    var MS = window.ManagedMediaSource || window.MediaSource;
    var mime = 'video/mp4; codecs="avc1.4d002a, ' + (aac ? 'mp4a.40.2' : 'mp4a.6b') + '"';
    if (MS && MS.isTypeSupported(mime)) {
        var ms = new MS();
        v.src = URL.createObjectURL(ms);
        ms.addEventListener('sourceopen', function () {
            var sb = ms.addSourceBuffer(mime);
            var queue = [];
            var keep = ts ? 120 : 10; // seconds kept behind the playhead: the archive allows seeking back
            function pump() {
                if (sb.updating || ms.readyState !== 'open') return;
                if (queue.length) {
                    sb.appendBuffer(queue.shift());
                } else if (v.buffered.length && v.currentTime - v.buffered.start(0) > keep + 20) {
                    sb.remove(0, v.currentTime - keep); // keep the buffer small
                }
            }
            sb.addEventListener('updateend', pump);
            fetch(src, {signal: stop.signal}).then(function (res) {
                if (!res.ok) throw new Error(res.status);
                var reader = res.body.getReader();
                function read() {
                    reader.read().then(function (chunk) {
                        if (chunk.done) { if (ms.readyState === 'open') ms.endOfStream(); return; }
                        queue.push(chunk.value);
                        pump();
                        read();
                    }).catch(function () {});
                }
                read();
            }).catch(function (e) { if (!stop.signal.aborted) document.title = 'Поток недоступен (' + e.message + ')'; });
            // Stay near the live edge if the player fell behind (tab in background).
            if (!ts) setInterval(function () {
                if (!v.buffered.length) return;
                var end = v.buffered.end(v.buffered.length - 1);
                if (end - v.currentTime > 3) v.currentTime = end - 1;
            }, 1000);
        });
    } else {
        v.src = src; // ponytail: no MSE at all, let the browser try progressive playback
    }
    // Try to start with sound; browsers allow that only after a user gesture
    // on the site, so fall back to a muted autoplay (tap the speaker to unmute).
    v.play().catch(function () {
        v.muted = true;
        v.play().catch(function () {});
    });
    if (ts) {
        // The archive arrives in real time, so a jump is a new request from
        // another TS (~2-3 s to the first frame); seeking back inside what
        // already played stays in the <video> buffer.
        var base = null; // media time of the first frame = ts
        var now = function () { return Math.floor(Date.now() / 1000); };
        var clock = function () { return base === null ? ts : ts + Math.floor(v.currentTime - base); };
        var local = function (t) { // datetime-local wants local time without a zone
            var d = new Date(t * 1000);
            d.setMinutes(d.getMinutes() - d.getTimezoneOffset());
            return d.toISOString().slice(0, 19);
        };
        var go = function (t) {
            t = Math.max(now() - depth + 60, Math.min(t, now() - 10)); // older hangs, newer falls back to live
            location.replace('?ts=' + t + (light ? '&light=1' : ''));
        };
        var at = document.getElementById('at');
        at.value = local(ts);
        at.min = local(now() - depth + 60);
        at.max = local(now());
        at.addEventListener('change', function () {
            var t = Math.floor(new Date(at.value).getTime() / 1000);
            if (t) go(t);
        });
        document.querySelectorAll('#bar button').forEach(function (b) {
            b.addEventListener('click', function () { go(clock() + Number(b.dataset.d)); });
        });
        setInterval(function () {
            if (base === null && v.buffered.length) base = v.buffered.start(0);
            document.getElementById('clock').textContent = new Date(clock() * 1000).toLocaleString('ru-RU');
        }, 500);
        // A paused archive would keep downloading in real time with nowhere to
        // put it; drop the stream and resume from the same moment on play.
        v.addEventListener('pause', function () { stop.abort(); });
        v.addEventListener('play', function () { if (stop.signal.aborted) go(clock()); });
    }
</script>
</body>
</html>
