<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Domru</title>
    <style type="text/css">
        html, body {
            height: 100%;
            background: white
        }

        body {
            font: 1.5em/2em, cursive;
            font-family: Arial, Helvetica, sans-serif;
            color: #5b5983;
            text-align: center;
        }

        .alert.alert-danger {
            background-color: rgb(242, 222, 222);
            border: 1px solid rgb(235, 204, 209);
            border-radius: 4px;
            box-sizing: border-box;
            color: rgb(169, 68, 66);
            line-height: 22.5px;
            margin-bottom: 20px;
            padding: 15px;
        }

        .alert.alert-danger:empty {
            display: none;
        }

        #wrapper {
            max-width: 768px;
            margin: 0 auto;
        }

        .resp-table {
            display: table;
            width: 100%;
        }

        .resp-table-body {
            display: table-row-group;
        }

        .resp-table-row {
            display: table-row;
        }

        .table-body-cell {
            display: table-cell;
            text-align: left;
            padding: 4px;
        }

        pre {
            text-align: left;
            white-space: pre-wrap;
            overflow-wrap: anywhere;
        }

        .camera-card {
            margin: 24px 0;
            padding-top: 16px;
            border-top: 1px solid #ddd;
            text-align: left;
        }

        a { color: inherit; overflow-wrap: anywhere; }
        img { max-width: 100%; height: auto; }
        h1 { font-size: 1.4em; }
        h2 { font-size: 1.1em; }
    </style>
</head>
<body>
<main id="wrapper">
    <p id="integrations" hidden><span id="integrations-text"></span><span id="video-controls" hidden>
        · Видео в Telegram:
        <span style="display: inline-flex; flex-direction: column; gap: .25em; vertical-align: top;">
            <select id="video-mode" onchange="setVideo()">
                <option value="off">выкл</option>
                <option value="archive">архив</option>
                <option value="live">онлайн</option>
            </select>
            <select id="video-light" onchange="setVideo()">
                <option value="0">1920×1080</option>
                <option value="1">960×528</option>
            </select>
        </span>
        <span id="video-error"></span></span></p>
    {{ if .LoginError }}
    <div class="alert alert-danger" role="alert">{{ .LoginError }}</div>
    {{ end }}
    {{ if .Phone }}<p>Номер телефона: +{{ .Phone }}</p>{{ end }}
    {{ range .CameraCards }}
    <section class="camera-card">
        <h2>{{ .Section }} — {{ .Name }}</h2>
        <div class="resp-table">
            <div class="resp-table-body">
                <div class="resp-table-row">
                    <div class="table-body-cell">Камера:</div>
                    <div class="table-body-cell">{{ if .ID }}№ {{ .ID }}{{ else }}Идентификатор пока недоступен{{ end }}</div>
                </div>
                <div class="resp-table-row">
                    <div class="table-body-cell">Адрес / название:</div>
                    <div class="table-body-cell">
                        {{ .Name }}
                        {{ if .OpenDoorURL }}<button onclick="openDoor({{ .OpenDoorURL }})">Открыть</button>{{ end }}
                    </div>
                </div>
                <div class="resp-table-row">
                    <div class="table-body-cell">Доступ:</div>
                    <div class="table-body-cell">{{ .Status }}</div>
                </div>
                {{ if .StreamURL }}
                <div class="resp-table-row">
                    <div class="table-body-cell">Видеопоток:</div>
                    <div class="table-body-cell"><a href="{{ .StreamURL }}">{{ .StreamURL }}</a></div>
                </div>
                {{ end }}
                {{ if .SnapshotURL }}
                <div class="resp-table-row">
                    <div class="table-body-cell">Снимок:</div>
                    <div class="table-body-cell"><a href="{{ .SnapshotURL }}">{{ .SnapshotURL }}</a></div>
                </div>
                <div class="resp-table-row">
                    <div class="table-body-cell"></div>
                    <div class="table-body-cell"><img src="{{ .SnapshotURL }}" alt="{{ .Name }}" width="320" loading="lazy"></div>
                </div>
                {{ end }}
            </div>
        </div>
        {{ if or .StreamURL .SnapshotURL .OpenDoorURL }}
        <pre># Home Assistant configuration:
{{ if .OpenDoorURL }}rest_command:
    {{ .ConfigName }}_open_door:
        url: {{ .OpenDoorURL }}
        method: post
        headers:
            accept: "application/json"
        content_type: 'application/json; charset=utf-8'
        payload: '{"name":"accessControlOpen"}'
{{ end }}{{ if or .StreamURL .SnapshotURL }}
camera:
    - platform: generic
        name: {{ .ConfigName }}
{{ if .SnapshotURL }}        still_image_url: {{ .SnapshotURL }}
{{ end }}{{ if .StreamURL }}        stream_source: {{ .StreamURL }}
{{ end }}{{ end }}</pre>
        {{ end }}
    </section>
    {{ else }}
    <p>Камеры не найдены.</p>
    {{ end }}
</main>
<script>
// ponytail: one line of status from /api/integrations/state, hidden when SIP and Telegram are both off.
function showIntegrations() {
    fetch('/api/integrations/state', {cache: 'no-store'}).then(r => r.json()).then(s => {
        const p = document.getElementById('integrations');
        if (s.sip.state === 'off' && s.telegram.state === 'off') { p.hidden = true; return; }
        const part = (name, x) => name + ': ' + x.state + (x.error ? ' (' + x.error + ')' : '');
        const calls = (s.sip.calls || []).filter(c => ['ringing', 'answering', 'established'].includes(c.state));
        let text = part('SIP', s.sip) + ' · ' + part('Telegram', s.telegram) + ' · Завершение звонка: ' + s.end_mode;
        if (calls.length) text += ' · Звонок: ' + calls.map(c => c.state).join(', ');
        if (s.webhook_error) text += ' · Webhook: ' + s.webhook_error;
        document.getElementById('integrations-text').textContent = text;
        showVideo(s.video);
        p.hidden = false;
    }).catch(() => {});
}
// The archive option needs a subscription; the stream size matters only for live.
function showVideo(v) {
    const box = document.getElementById('video-controls');
    box.hidden = !v;
    if (!v) return;
    const mode = document.getElementById('video-mode'), light = document.getElementById('video-light');
    const archive = mode.querySelector('option[value=archive]');
    archive.disabled = !v.archive;
    archive.title = v.archive ? '' : 'Нужна подписка Дом.ру с записью';
    if (document.activeElement !== mode) mode.value = v.mode || 'off';
    if (document.activeElement !== light) light.value = v.light ? '1' : '0';
    light.hidden = v.mode !== 'live';
    document.getElementById('video-error').textContent = v.mode === 'live' && v.buffer && v.buffer !== 'connected' ? ' (' + v.buffer + ')' : '';
}
function setVideo() {
    const body = {mode: document.getElementById('video-mode').value, light: document.getElementById('video-light').value === '1'};
    document.getElementById('video-error').textContent = ' …';
    fetch('/api/video', {method: 'POST', headers: {"Content-Type": "application/json"}, body: JSON.stringify(body)})
        .then(r => r.json().then(v => { if (!r.ok) throw new Error(v.error); showVideo(v); }))
        .catch(e => { document.getElementById('video-error').textContent = ' ⚠️ ' + e.message; setTimeout(showIntegrations, 3000); });
}
showIntegrations();
setInterval(showIntegrations, 10000);
function openDoor(url) {
    fetch(url, {method: 'POST', headers: {"Content-Type": "application/json"}, body: JSON.stringify({name: 'accessControlOpen'})});
}
</script>
</body>
</html>
